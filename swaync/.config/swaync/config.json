{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 18,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 420,
  "control-center-height": 1045,
  "layer-shell-cover-screen": false,
  "notification-window-width": 400,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "[ NO INCOMING DATA ]",
  "script-fail-notify": true,
  "scripts": {
    "cyberpunk-notify-sound": {
      "exec": "canberra-gtk-play -i message-new-instant --property=canberra.xdg-theme.name=cyberpunk-2077"
    }
  },
  "notification-visibility": {},
  "widgets": [
    "title",
    "dnd",
    "buttons-grid#quick-actions",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "title": {
      "text": "// NOTIFICATION HUB",
      "clear-all-button": true,
      "button-text": "CLEAR ALL"
    },
    "dnd": {
      "text": "DO NOT DISTURB"
    },
    "mpris": {
      "blacklist": [],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": false
    },
    "buttons-grid#quick-actions": {
      "buttons-per-row": 6,
      "actions": [
        { 
          "label": "🔕",
          "type": "toggle",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && swaync-client --dnd-on || swaync-client --dnd-off'",
          "update-command": "sh -c '[[ $(swaync-client -D) == true ]] && echo true || echo false'"
        },
        {
          "label": "🎤",
          "type": "toggle",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && wpctl set-mute @DEFAULT_SOURCE@ 1 || wpctl set-mute @DEFAULT_SOURCE@ 0'",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_SOURCE@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "📶",
          "type": "toggle",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli radio wifi) == enabled ]] && echo true || echo false'"
        },
        {
          "label": "🅱",
          "type": "toggle",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -qE Powered:.*yes && echo true || echo false'"
        },
        { "label": "📸", "type": "normal", "command": "hyprshot -m region -o ~/Immagini/Screenshots" },
        { "label": "🎨", "type": "normal", "command": "hyprpicker -a -r" }
      ]
    }
  }
}
