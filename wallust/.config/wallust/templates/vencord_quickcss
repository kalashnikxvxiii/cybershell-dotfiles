/* Generated by wallust — Vencord QuickCSS override
 * Carica DOPO theme principale. Override solo accent dinamici.
 * cyberpunk2077.theme.css mantiene background/font/struttura.
 */

:root,
.theme-dark,
.theme-darker,
.theme-light {
    /* Brand / accent: wallust color4 (primary accent) — Discord 2024+ */
    --brand-500:                           rgb({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}) !important;
    --brand-experiment:                    {{color4 | red}}, {{color4 | green}}, {{color4 | blue}} !important;
    --brand-experiment-500:                rgb({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}) !important;
    --brand-experiment-560:                rgb({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}) !important;
    --brand-experiment-600:                rgba({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}, 0.9) !important;
    --brand-experiment-400:                rgb({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}) !important;

    /* Bottoni primari */
    --button-positive-background:          rgb({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}) !important;
    --button-positive-background-hover:    rgb({{color6 | red}}, {{color6 | green}}, {{color6 | blue}}) !important;

    /* Mention / link: wallust color6 (secondary accent) */
    --text-link:                           rgb({{color6 | red}}, {{color6 | green}}, {{color6 | blue}}) !important;
    --text-link-low-saturation:            rgb({{color6 | red}}, {{color6 | green}}, {{color6 | blue}}) !important;
    --mention-foreground:                  rgb({{color6 | red}}, {{color6 | green}}, {{color6 | blue}}) !important;
    --mention-background:                  rgba({{color6 | red}}, {{color6 | green}}, {{color6 | blue}}, 0.15) !important;

    /* Header titles */
    --header-primary:                      rgb({{color7 | red}}, {{color7 | green}}, {{color7 | blue}}) !important;

    /* Selected channel highlight */
    --background-modifier-selected:        rgba({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}, 0.3) !important;
    --background-modifier-accent:          rgba({{color5 | red}}, {{color5 | green}}, {{color5 | blue}}, 0.2) !important;

    /* Scrollbar thumb: wallust color8 (muted) */
    --scrollbar-thin-thumb:                rgba({{color8 | red}}, {{color8 | green}}, {{color8 | blue}}, 0.6) !important;
    --scrollbar-auto-thumb:                rgba({{color8 | red}}, {{color8 | green}}, {{color8 | blue}}, 0.6) !important;
}
