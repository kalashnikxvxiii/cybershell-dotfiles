{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Generated by wallust — do not edit manually.
  // Source: ~/.config/wallust/templates/fastfetch_config

  "logo": {
    "padding": { "left": 2, "top": 1 },
    "type": "kitty-direct",
    "source": "~/.local/share/icons/hicolor/512x512/apps/cachyos.png"
  },
  "display": {
    "separator": "  ▶  ",
    "color": {
      "keys":   "38;2;252;236;12",
      "title":  "38;2;{{color6 | red}};{{color6 | green}};{{color6 | blue}}",
      "output": "38;2;{{foreground | red}};{{foreground | green}};{{foreground | blue}}"
    }
  },
  "modules": [
    "break",

    // ── IDENTITY ──────────────────────────────────────────────────────────
    {
      "type": "title",
      "key": " ",
      "format": "\u001b[1;38;2;{{color4 | red}};{{color4 | green}};{{color4 | blue}}m{user-name}\u001b[0m\u001b[38;2;234;0;217m@\u001b[0m\u001b[1;38;2;{{color6 | red}};{{color6 | green}};{{color6 | blue}}m{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "  \u001b[38;2;{{color8 | red}};{{color8 | green}};{{color8 | blue}}m── IDENTITY ──────────────────────────────────────────\u001b[0m"
    },
    { "type": "os",      "key": "▌ OS       ", "keyColor": "38;2;252;236;12" },
    { "type": "kernel",  "key": "▌ KERNEL   ", "keyColor": "38;2;252;236;12" },
    { "type": "uptime",  "key": "▌ UPTIME   ", "keyColor": "38;2;252;236;12" },
    { "type": "packages","key": "▌ PACKAGES ", "keyColor": "38;2;252;236;12" },

    "break",

    // ── CORE.MATRIX ───────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "  \u001b[38;2;{{color8 | red}};{{color8 | green}};{{color8 | blue}}m── CORE.MATRIX ───────────────────────────────────────\u001b[0m"
    },
    { "type": "cpu",     "key": "▌ CPU      ", "keyColor": "38;2;252;236;12" },
    { "type": "gpu",     "key": "▌ GPU      ", "keyColor": "38;2;252;236;12" },
    { "type": "memory",  "key": "▌ MEMORY   ", "keyColor": "38;2;234;0;217" },
    { "type": "disk",    "key": "▌ DISK     ", "keyColor": "38;2;37;225;237" },
    { "type": "display", "key": "▌ DISPLAY  ", "keyColor": "38;2;37;225;237" },

    "break",

    // ── CONNECTIVITY ──────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "  \u001b[38;2;{{color8 | red}};{{color8 | green}};{{color8 | blue}}m── CONNECTIVITY ──────────────────────────────────────\u001b[0m"
    },
    { "type": "localip",   "key": "▌ NET      ", "keyColor": "38;2;37;225;237", "format": "{ifname} {ipv4}" },
    { "type": "bluetooth", "key": "▌ BT       ", "keyColor": "38;2;37;225;237" },

    "break",

    // ── INTERFACE ─────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "  \u001b[38;2;{{color8 | red}};{{color8 | green}};{{color8 | blue}}m── INTERFACE ─────────────────────────────────────────\u001b[0m"
    },
    { "type": "shell",        "key": "▌ SHELL    ", "keyColor": "38;2;252;236;12" },
    { "type": "terminal",     "key": "▌ TERM     ", "keyColor": "38;2;252;236;12" },
    { "type": "terminalfont", "key": "▌ FONT     ", "keyColor": "38;2;252;236;12" },
    { "type": "wm",           "key": "▌ WM       ", "keyColor": "38;2;234;0;217" },
    { "type": "theme",        "key": "▌ THEME    ", "keyColor": "38;2;234;0;217" },
    { "type": "icons",        "key": "▌ ICONS    ", "keyColor": "38;2;234;0;217" },

        "break",

    // ── SPECTRUM ──────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "  \u001b[38;2;{{color8 | red}};{{color8 | green}};{{color8 | blue}}m── SPECTRUM ──────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "▌ \u001b[38;2;252;236;12mPALETTE\u001b[0m    ▶  \u001b[38;2;80;80;90m░▒▓\u001b[0m\u001b[38;2;{{color0 | red}};{{color0 | green}};{{color0 | blue}}m███\u001b[38;2;{{color1 | red}};{{color1 | green}};{{color1 | blue}}m███\u001b[38;2;{{color2 | red}};{{color2 | green}};{{color2 | blue}}m███\u001b[38;2;{{color3 | red}};{{color3 | green}};{{color3 | blue}}m███\u001b[38;2;{{color4 | red}};{{color4 | green}};{{color4 | blue}}m███\u001b[38;2;{{color5 | red}};{{color5 | green}};{{color5 | blue}}m███\u001b[38;2;{{color6 | red}};{{color6 | green}};{{color6 | blue}}m███\u001b[38;2;{{color7 | red}};{{color7 | green}};{{color7 | blue}}m███\u001b[38;2;{{color8 | red}};{{color8 | green}};{{color8 | blue}}m███\u001b[38;2;{{color9 | red}};{{color9 | green}};{{color9 | blue}}m███\u001b[38;2;{{color10 | red}};{{color10 | green}};{{color10 | blue}}m███\u001b[38;2;{{color11 | red}};{{color11 | green}};{{color11 | blue}}m███\u001b[38;2;{{color12 | red}};{{color12 | green}};{{color12 | blue}}m███\u001b[38;2;{{color13 | red}};{{color13 | green}};{{color13 | blue}}m███\u001b[38;2;{{color14 | red}};{{color14 | green}};{{color14 | blue}}m███\u001b[38;2;{{color15 | red}};{{color15 | green}};{{color15 | blue}}m███\u001b[0m\u001b[38;2;80;80;90m▓▒░\u001b[0m"
    },
    {
      "type": "custom",
      "format": "▌ \u001b[38;2;252;236;12mCP2077\u001b[0m     ▶  \u001b[38;2;80;80;90m░▒▓\u001b[0m\u001b[38;2;252;236;12m████████\u001b[38;2;37;225;237m████████\u001b[38;2;234;0;217m████████\u001b[38;2;197;0;60m████████\u001b[38;2;0;255;159m████████\u001b[0m\u001b[38;2;80;80;90m▓▒░\u001b[0m"
    },

    "break"
  ]
}
